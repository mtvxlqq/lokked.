{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokked",
  "version": "0.3.0",
  "identifier": "com.lokked.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lokked",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage", "deb"],
    "category": "Education",
    "shortDescription": "Таймеры по предметам, карточки и статистика",
    "longDescription": "Lokked — приложение для учёбы: таймеры по предметам (включая Pomodoro и чёрный экран), учебные карточки с формулами и статистика по времени и точности. Данные хранятся локально.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "epoch": 0,
        "release": "1"
      },
      "deb": {
        "depends": []
      }
    }
  }
}
